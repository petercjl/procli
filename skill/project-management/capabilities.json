      "output_fields": ["target", "project", "task", "run", "verification"],
      "side_effects": {"external_mutation": true, "may_cost_money": false, "authorization": "Authenticated Agent run recording; production requires --yes."},
      "errors": ["PROJECT_STATE_CHANGED", "RUN_STATE_CHANGED", "EVIDENCE_REQUIRED", "EVIDENCE_NOT_FOUND"]
